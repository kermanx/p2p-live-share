{
  "publisher": "kermanx",
  "name": "p2p-live-share",
  "displayName": "CRC Live Share (PUC Minas)",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "description": "Colaboração ao vivo para o ecossistema DevOcto.",
  "author": {
    "name": "_Kerman",
    "email": "kermanx@qq.com",
    "url": "https://github.com/kermanx"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kermanx/p2p-live-share.git"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "icon": "assets/icon.png",
  "browser": "./dist/browser.js",
  "engines": {
    "vscode": "^1.99.0"
  },
  "activationEvents": [
    "onFileSystem:p2p-live-share"
  ],
  "contributes": {
    "commands": [
      {
        "command": "p2p-live-share.host",
        "title": "Iniciar Sessão (Professor)",
        "icon": "$(play)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.join",
        "title": "Entrar na Sala",
        "icon": "$(sign-in)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.joinNewWindow",
        "title": "Entrar na Sala (Nova Janela)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.leave",
        "title": "Sair da Sala",
        "icon": "$(sign-out)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.stop",
        "title": "Encerrar Sessão",
        "icon": "$(stop-circle)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.focusParticipant",
        "title": "Focar Estudante",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.followParticipant",
        "title": "Acompanhar Estudante",
        "icon": "$(eye)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.unfollowParticipant",
        "title": "Parar de Acompanhar",
        "icon": "$(eye-closed)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.copyInviteLink",
        "title": "Copiar Link de Convite",
        "icon": "$(link)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.createSharedTerminal",
        "title": "Criar Terminal Compartilhado",
        "icon": "$(add)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.focusSharedTerminal",
        "title": "Focar Terminal Compartilhado",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.closeSharedTerminal",
        "title": "Fechar Terminal Compartilhado",
        "icon": "$(close)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.executeHostCommand",
        "title": "Dummy command",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.allowEdit",
        "title": "Liberar Edição",
        "icon": "$(lock)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.revokeEdit",
        "title": "Bloquear Edição",
        "icon": "$(unlock)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.unlockAll",
        "title": "Modo Controle Ativado (Ir para Livre)",
        "icon": "$(lock)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.lockAll",
        "title": "Modo Livre Ativado (Ir para Controle)",
        "icon": "$(unlock)",
        "category": "CRC Live Share"
      },
      {
        "command": "p2p-live-share.forceSync",
        "title": "Forçar Sincronização (Corrigir Erros)",
        "icon": "$(sync)",
        "category": "CRC Live Share"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "p2p-live-share-panel",
          "title": "CRC Live Share",
          "icon": "./assets/panel-icon.svg"
        }
      ]
    },
    "views": {
      "p2p-live-share-panel": [
        {
          "id": "p2p-live-share.participants",
          "name": "Participantes",
          "type": "tree"
        },
        {
          "id": "p2p-live-share.terminals",
          "name": "Terminais Compartilhados",
          "type": "tree",
          "when": "p2p-live-share:inSession"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "p2p-live-share.stop",
          "when": "view == p2p-live-share.participants && p2p-live-share:isHost",
          "group": "navigation"
        },
        {
          "command": "p2p-live-share.copyInviteLink",
          "when": "view == p2p-live-share.participants && p2p-live-share:inSession",
          "group": "navigation"
        },
        {
          "command": "p2p-live-share.leave",
          "when": "view == p2p-live-share.participants && p2p-live-share:isGuest",
          "group": "navigation"
        },
        {
          "command": "p2p-live-share.createSharedTerminal",
          "when": "view == p2p-live-share.terminals && p2p-live-share:isHost",
          "group": "navigation"
        },
        {
          "command": "p2p-live-share.unlockAll",
          "when": "view == p2p-live-share.participants && p2p-live-share:isHost && p2p-live-share:globalLock",
          "group": "navigation@1"
        },
        {
          "command": "p2p-live-share.lockAll",
          "when": "view == p2p-live-share.participants && p2p-live-share:isHost && !p2p-live-share:globalLock",
          "group": "navigation@1"
        },
        {
          "command": "p2p-live-share.forceSync",
          "when": "view == p2p-live-share.participants && p2p-live-share:isHost",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "p2p-live-share.followParticipant",
          "when": "view == p2p-live-share.participants && viewItem == not-following",
          "group": "inline"
        },
        {
          "command": "p2p-live-share.unfollowParticipant",
          "when": "view == p2p-live-share.participants && viewItem == following",
          "group": "inline"
        },
        {
          "command": "p2p-live-share.closeSharedTerminal",
          "when": "view == p2p-live-share.terminals && p2p-live-share:isHost",
          "group": "inline"
        },
        {
          "command": "p2p-live-share.allowEdit",
          "when": "view == p2p-live-share.participants && p2p-live-share:isHost && p2p-live-share:globalLock && viewItem =~ /readonly/",
          "group": "inline@2"
        },
        {
          "command": "p2p-live-share.revokeEdit",
          "when": "view == p2p-live-share.participants && p2p-live-share:isHost && p2p-live-share:globalLock && viewItem =~ /can-edit/",
          "group": "inline@2"
        }
      ],
      "statusBar/remoteIndicator": [
        {
          "command": "p2p-live-share.host",
          "group": "virtualfs_00_p2p-live-share_kermanx",
          "when": "!p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.join",
          "group": "virtualfs_00_p2p-live-share_kermanx",
          "when": "!p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.joinNewWindow",
          "group": "virtualfs_00_p2p-live-share_kermanx",
          "when": "!p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.stop",
          "group": "virtualfs_00_p2p-live-share_kermanx",
          "when": "p2p-live-share:isHost"
        },
        {
          "command": "p2p-live-share.leave",
          "group": "virtualfs_00_p2p-live-share_kermanx",
          "when": "p2p-live-share:isGuest"
        },
        {
          "command": "p2p-live-share.copyInviteLink",
          "group": "virtualfs_00_p2p-live-share_kermanx",
          "when": "p2p-live-share:inSession"
        }
      ],
      "commandPalette": [
        {
          "command": "p2p-live-share.host",
          "when": "!p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.join",
          "when": "!p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.joinNewWindow",
          "when": "!p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.stop",
          "when": "p2p-live-share:isHost"
        },
        {
          "command": "p2p-live-share.leave",
          "when": "p2p-live-share:isGuest"
        },
        {
          "command": "p2p-live-share.focusParticipant",
          "when": "p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.followParticipant",
          "when": "p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.unfollowParticipant",
          "when": "p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.copyInviteLink",
          "when": "p2p-live-share:inSession"
        },
        {
          "command": "p2p-live-share.createSharedTerminal",
          "when": "p2p-live-share:inSession && p2p-live-share:isHost"
        },
        {
          "command": "p2p-live-share.focusSharedTerminal",
          "when": "false"
        },
        {
          "command": "p2p-live-share.closeSharedTerminal",
          "when": "false"
        },
        {
          "command": "p2p-live-share.executeHostCommand",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "p2p-live-share.participants",
        "contents": "Bem-vindo ao painel do CRC Live Share.\n[Iniciar Sessão (Professor)](command:p2p-live-share.host)\n[Entrar na Sala](command:p2p-live-share.join)",
        "when": "!p2p-live-share:inSession"
      },
      {
        "view": "p2p-live-share.participants",
        "contents": "Convide alunos compartilhando o link.\n[Copiar Link](command:p2p-live-share.copyInviteLink)",
        "when": "p2p-live-share:inSession"
      },
      {
        "view": "p2p-live-share.terminals",
        "contents": "Um terminal remoto permite que alunos assistam aos logs da sua máquina em tempo real. \n[Criar Terminal Compartilhado](command:p2p-live-share.createSharedTerminal)",
        "when": "p2p-live-share:inSession && p2p-live-share:isHost"
      }
    ],
    "configuration": {
      "title": "CRC Live Share (PUC Minas)",
      "properties": {
        "p2p-live-share.userName": {
          "type": "string",
          "default": "",
          "description": "Seu nome na sessão."
        },
        "p2p-live-share.terminal.dimensionsSource": {
          "type": "string",
          "enum": [
            "host",
            "creator",
            "minimum",
            "maximum"
          ],
          "default": "minimum",
          "description": "Calculo de dimensões para terminais."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "p2p-live-share.sharedTerminal",
          "title": "Shared Terminal",
          "icon": "live-share"
        }
      ]
    },
    "colors": [
      {
        "id": "p2pliveshare.participant.loading",
        "description": "Cor de carregamento",
        "defaults": {
          "dark": "#808080",
          "light": "#808080"
        }
      },
      {
        "id": "p2pliveshare.participant.1",
        "description": "Cor 1",
        "defaults": { "dark": "#ffb900", "light": "#ffb900" }
      },
      {
        "id": "p2pliveshare.participant.2",
        "description": "Cor 2",
        "defaults": { "dark": "#107c10", "light": "#107c10" }
      },
      {
        "id": "p2pliveshare.participant.3",
        "description": "Cor 3",
        "defaults": { "dark": "#b4009e", "light": "#b4009e" }
      },
      {
        "id": "p2pliveshare.participant.4",
        "description": "Cor 4",
        "defaults": { "dark": "#ff8c00", "light": "#ff8c00" }
      },
      {
        "id": "p2pliveshare.participant.5",
        "description": "Cor 5",
        "defaults": { "dark": "#e3008c", "light": "#e3008c" }
      },
      {
        "id": "p2pliveshare.participant.6",
        "description": "Cor 6",
        "defaults": { "dark": "#5c2d91", "light": "#5c2d91" }
      },
      {
        "id": "p2pliveshare.participant.7",
        "description": "Cor 7",
        "defaults": { "dark": "#fff100", "light": "#fff100" }
      },
      {
        "id": "p2pliveshare.participant.8",
        "description": "Cor 8",
        "defaults": { "dark": "#b4a0ff", "light": "#b4a0ff" }
      }
    ]
  },
  "scripts": {
    "build": "tsdown --env.NODE_ENV production --minify --clean",
    "dev": "tsdown --watch --env.NODE_ENV development",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "pnpm run build",
    "browser": "vscode-test-web --quality stable --browser none --extensionDevelopmentPath=. ./test-workspace",
    "lint": "eslint . --cache",
    "release": "bumpp package.json"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.1",
    "@types/node": "^20.19.30",
    "@types/picomatch": "^4.0.3",
    "@types/vscode": "^1.99.0",
    "@types/ws": "^8.18.1",
    "@vscode/test-web": "^0.0.78",
    "@vscode/windows-process-tree": "^0.6.3",
    "@y/protocols": "1.0.6-0",
    "birpc": "^4.0.0",
    "bumpp": "^10.4.0",
    "eslint": "^9.39.2",
    "eslint-plugin-format": "^1.3.1",
    "lib0": "^0.2.117",
    "msgpackr": "^1.11.9",
    "nanoid": "^5.1.6",
    "node-pty": "^1.2.0-beta.6",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "reactive-vscode": "^1.0.1",
    "tsdown": "^0.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vscode-languageclient": "^10.0.0-next.19",
    "vscode-languageserver": "^10.0.0-next.16",
    "ws": "^8.19.0",
    "y-array": "^10.1.4",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29"
  }
}